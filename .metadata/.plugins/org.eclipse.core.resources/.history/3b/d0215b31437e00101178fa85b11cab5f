package com.Assignments;

import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.Keys;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;

public class A24DemoQA_Registration {

	public static void main(String[] args) {
		WebDriver driver = new ChromeDriver();
		driver.manage().window().maximize();
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));

		driver.get("https://demoqa.com/automation-practice-form");
		
		driver.findElement(By.xpath("//input[@id='firstName']")).sendKeys("Kajal");
		driver.findElement(By.xpath("//input[@id='lastName']")).sendKeys("Barne");
		driver.findElement(By.xpath("//input[@id='userEmail']")).sendKeys("kajal@gmail.com");
		driver.findElement(By.xpath("//label[@for='gender-radio-2']")).click();
		driver.findElement(By.xpath("//input[@id='userNumber']")).sendKeys("8787878787");
		driver.findElement(By.xpath("//input[@id='dateOfBirthInput']")).sendKeys(Keys.CONTROL + "A");
		driver.findElement(By.xpath("//input[@id='dateOfBirthInput']")).sendKeys("24 Nov 2000");
		
	}

}
